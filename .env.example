# URL base dos vídeos na API StudyTube.
# O perfil "http" do backend escuta em http://localhost:5126
# (StudyTube.Api/Properties/launchSettings.json).
# Sem esta variável, o frontend usa esse endereço. Para sobrescrever,
# copie este arquivo para .env.local e ajuste o valor.
VITE_API_URL=http://localhost:5126/api/videos
